{
  "installCommand": "npm install --omit=dev",
  "buildCommand": "node scripts/roadmap-gate.mjs",
  "redirects": [
    {
      "source": "/",
      "destination": "/index-grupal.html",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/index-grupal.html",
      "permanent": false
    },
    {
      "source": "/stableford-torneo.html",
      "destination": "/index-grupal.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/index-grupal.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(player-registry|round-closure|card-artifacts|card-file-export|card-library|historical-analytics|stableford|sync-queue|master-data-sync|account-backup|commerce|round-navigation).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0"
        }
      ]
    }
  ]
}

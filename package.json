{
  "name": "golf-score-card-gt",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.74",
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@neondatabase/serverless": "^1.0.2",
    "@revenuecat/purchases-capacitor": "13.4.0",
    "@revenuecat/purchases-capacitor-ui": "13.4.0",
    "@vercel/oidc": "3.8.5"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.0",
    "esbuild": "0.28.2",
    "sharp": "0.35.3"
  },
  "scripts": {
    "roadmap:gate": "node scripts/roadmap-gate.mjs",
    "inventory:gate": "node scripts/inventory-gate.mjs",
    "quality:gate": "node scripts/project-quality-gate.mjs",
    "intocables:gate": "node Intocables/intocables-gate.mjs",
    "voice:ios-gate": "node test-v357-ios-voice-transport-recovery.mjs",
    "voice:progressive-gate": "node test-v357-synchronized-progressive-voice.mjs",
    "voice:synchronized-gate": "node test-v361-synchronized-voice.mjs",
    "voice:physical-gate": "node test-v362-physical-voice-recovery.mjs",
    "external:oidc-gate": "node test-v364-vercel-oidc-recovery.mjs",
    "behavior:recorded-gate": "node test-v363-recorded-mobile-behavior.mjs",
    "entry:new-round-gate": "node test-v364-explicit-new-round-entry.mjs",
    "round:recovery-gate": "node test-v365-active-round-empty-recovery.mjs",
    "principal:entry-gate": "node test-v366-principal-entry-recovery.mjs",
    "universal:in-place-gate": "node test-v367-universal-voice-in-place.mjs",
    "entry:canonical-home-gate": "node test-v368-canonical-home-entry.mjs",
    "voice:weather-traffic-recovery-gate": "node test-v369-physical-voice-weather-traffic-recovery.mjs",
    "voice:native-spanish-fast-close-gate": "node test-v370-native-spanish-fast-close.mjs",
    "universal:spanish-only-gate": "node test-v371-spanish-only-universal.mjs",
    "voice:gateway-realtime-gate": "node test-v372-gateway-realtime-streaming.mjs",
    "audit": "node audit-project.mjs",
    "manual:editorial-qc": "python3 scripts/manual-editorial-qc.py",
    "manual:visual-qc": "python3 scripts/manual-visual-qc.py",
    "mobile:web": "node scripts/build-mobile-web.mjs",
    "mobile:add:ios": "npm run mobile:web && cap add ios",
    "mobile:add:android": "npm run mobile:web && cap add android",
    "mobile:configure": "node scripts/configure-native-projects.mjs",
    "mobile:assets": "node scripts/prepare-mobile-assets.mjs && capacitor-assets generate --iosProject native/ios/App --androidProject native/android --iconBackgroundColor '#000000' --iconBackgroundColorDark '#000000' --splashBackgroundColor '#000000' --splashBackgroundColorDark '#000000'",
    "mobile:sync": "npm run mobile:web && cap sync && npm run mobile:configure && npm run mobile:assets",
    "mobile:prepare": "node scripts/prepare-native-release.mjs",
    "mobile:open:ios": "cap open ios",
    "mobile:open:android": "cap open android"
  }
}
